#cloud-config
package_update: true
package_upgrade: false

runcmd:
  - [ sh, -lc, 'apt-get update' ]
  - [ sh, -lc, 'apt-get install -y ca-certificates curl git tar gzip' ]
  - [ sh, -lc, 'curl -fsSL https://get.docker.com | sh' ]
  - [ sh, -lc, 'systemctl enable --now docker' ]
  - [ sh, -lc, 'usermod -aG docker ${ssh_user} || true' ]
  - [ sh, -lc, 'mkdir -p /opt/garden/releases && chown -R ${ssh_user}:${ssh_user} /opt/garden' ]
  - [ sh, -lc, 'echo garden-bootstrap-ready > /var/lib/garden-bootstrap-ready' ]
